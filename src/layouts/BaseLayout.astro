---
import '../styles/global.css';
const { title = 'AstroJyotish', description = 'राशिफल, ज्योतिष और astrology की जानकारी।' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
---
<!doctype html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="alternate" type="application/rss+xml" title="AstroJyotish RSS" href="/rss.xml" />
</head>
<body>
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">Astro<span>Jyotish</span></a>
    <nav class="nav-links" aria-label="मुख्य मेनू">
      <a href="/">होम</a><a href="/posts/">लेख</a><a href="/category/rashifal/">राशिफल</a><a href="/category/jyotish/">ज्योतिष</a><a href="/about/">हमारे बारे में</a>
    </nav>
    <button class="menu-btn" aria-label="मेनू">☰</button>
  </div>
</header>
<main><slot /></main>
<footer class="site-footer"><div class="container footer-grid"><div><strong>AstroJyotish</strong><br />ज्योतिष और राशिफल से जुड़ी जानकारी।</div><div class="footer-links"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/rss.xml">RSS</a></div></div></footer>
</body>
</html>
