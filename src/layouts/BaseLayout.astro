---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import SeoSchema from '../components/SeoSchema.astro';
import AdSlot from '../components/AdSlot.astro';

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = `${siteConfig.url}/og-image.jpg`,
  type = 'website',
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImage = new URL(image, siteConfig.url).toString();
const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: siteConfig.description,
  inLanguage: 'hi-IN',
};
---
<!doctype html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml" />
  {siteConfig.code.head && <Fragment set:html={siteConfig.code.head} />}
  <SeoSchema data={schema ?? defaultSchema} />
</head>
<body>
  {siteConfig.code.header && <Fragment set:html={siteConfig.code.header} />}
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="/">Astro<span>Jyotish</span></a>
      <nav class="nav-links" aria-label="मुख्य मेनू">
        <a href="/">होम</a>
        <a href="/posts/">लेख</a>
        <a href="/categories/">श्रेणियां</a>
        <a href="/tags/">Tags</a>
        <a href="/about/">हमारे बारे में</a>
      </nav>
      <button class="menu-btn" aria-label="मेनू">☰</button>
    </div>
  </header>
  <main><slot /></main>
  <AdSlot slot="footer" />
  <footer class="site-footer">
    <div class="container footer-grid">
      <div><strong>{siteConfig.name}</strong><br />ज्योतिष और राशिफल से जुड़ी जानकारी।</div>
      <div class="footer-links"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/rss.xml">RSS</a></div>
    </div>
  </footer>
  {siteConfig.code.footer && <Fragment set:html={siteConfig.code.footer} />}
</body>
</html>
