---
const { post } = Astro.props;
---
<article class="card">
  <a href={`/posts/${post.id}/`} aria-label={post.data.title}>
    <div class="card-image">✦</div>
  </a>
  <div class="card-body">
    <div class="meta"><a class="category" href={`/category/${post.data.category.toLowerCase().replaceAll(' ','-')}/`}>{post.data.category}</a><span>•</span><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('hi-IN')}</time></div>
    <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="tag-list">{post.data.tags.slice(0,3).map(tag => <a class="tag" href={`/tag/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>
  </div>
</article>
