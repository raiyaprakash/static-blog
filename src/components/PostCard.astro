---
import { slugify, postSlug } from '../lib/slug';
const { post } = Astro.props;
const categorySlug = slugify(post.data.category);
const articleSlug = postSlug(post.id, post.data.slug);
---
<article class="card">
  <a href={`/posts/${articleSlug}/`} aria-label={post.data.title}>
    <div class="card-image">✦</div>
  </a>
  <div class="card-body">
    <div class="meta"><a class="category" href={`/category/${categorySlug}/`}>{post.data.category}</a><span>•</span><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('hi-IN')}</time></div>
    <h3><a href={`/posts/${articleSlug}/`}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="tag-list">{post.data.tags.slice(0,3).map(tag => <a class="tag" href={`/tag/${slugify(tag)}/`}>#{tag}</a>)}</div>
  </div>
</article>
