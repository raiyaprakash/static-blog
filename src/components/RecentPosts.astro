---
import { slugify, postSlug } from '../lib/slug';
const { posts = [], currentId = '', limit = 5 } = Astro.props;
const recent = posts.filter((p:any) => p.id !== currentId).slice(0, limit);
---
<div class="sidebar-block">
  <div class="sidebar-title"><h2>Recently Published</h2></div>
  <div class="recent-list">
    {recent.map((post:any) => {
      const url = `/posts/${postSlug(post.id, post.data.slug)}/`;
      return <a class="recent-item" href={url}>
        <span class="recent-thumb">JOB</span>
        <span><strong>{post.data.title}</strong><small>{post.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</small></span>
      </a>;
    })}
  </div>
</div>
