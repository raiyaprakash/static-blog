---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import SearchBox from '../components/SearchBox.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../lib/slug';
import { siteConfig } from '../config/site';
const posts=(await getCollection('posts')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const categories=[...new Set(posts.map(p=>p.data.category))];
const schema={'@context':'https://schema.org','@type':'WebSite',name:siteConfig.name,url:siteConfig.url,description:siteConfig.description,inLanguage:'en-US'};
---
<BaseLayout title={`${siteConfig.name} — Latest Jobs & Career Updates`} description={siteConfig.description} schema={schema}>
<section class="hero job-hero"><div class="container hero-grid"><div><span class="eyebrow">CAREERS • JOBS • GUIDES</span><h1>{siteConfig.homepage.heroTitle}</h1><p>{siteConfig.homepage.heroText}</p><SearchBox /><div class="hero-links"><a href="/posts/">Browse latest jobs →</a><a href="/categories/">Explore categories</a></div></div><div class="hero-panel"><div class="hero-icon">↗</div><strong>Career updates in one place</strong><p>Search job titles, companies, skills, locations and career topics.</p><div class="hero-stat"><b>{posts.length}+</b><span>published updates</span></div></div></div></section>
<AdSlot slot="homeTop" />
<section class="section"><div class="container"><div class="section-head"><div><h2>Browse by Category</h2><p>Find job updates and career content by topic.</p></div><a class="text-link" href="/categories/">View all →</a></div><div class="category-grid">{categories.slice(0,8).map(c=><a class="category-box" href={`/category/${slugify(c)}/`}><strong>{c}</strong><span>{posts.filter(p=>p.data.category===c).length} articles</span></a>)}</div></div></section>
<AdSlot slot="homeAfterHero" />
<section class="section" id="latest"><div class="container"><div class="section-head"><div><h2>{siteConfig.homepage.latestTitle}</h2><p>Fresh recruitment news, vacancies and career information.</p></div><a class="text-link" href="/posts/">View all →</a></div><div class="grid" id="post-grid">{posts.map((post,i)=><div class="post-item" data-index={i}><PostCard post={post}/></div>)}</div>{posts.length>siteConfig.homepage.postsPerLoad&&<button class="load-more" id="load-more">Load more posts</button>}<AdSlot slot="homeAfterPosts" /></div></section>
<AdSlot slot="homeBottom" />
<script define:vars={{initial:siteConfig.homepage.postsPerLoad}}>
const items=[...document.querySelectorAll('.post-item')];const btn=document.querySelector('#load-more');let shown=initial;if(btn){items.forEach((x,i)=>{if(i>=shown)x.hidden=true});btn.addEventListener('click',()=>{shown+=initial;items.forEach((x,i)=>{if(i<shown)x.hidden=false});if(shown>=items.length)btn.remove()})}
</script>
</BaseLayout>
