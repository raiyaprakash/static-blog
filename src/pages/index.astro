---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../lib/slug';
const posts = (await getCollection('posts')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const categories = [...new Set(posts.map(p=>p.data.category))];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AstroJyotish',
  url: 'https://static-blog-380.pages.dev/',
  description: 'दैनिक राशिफल, वार्षिक राशिफल और ज्योतिष से जुड़ी जानकारी।',
  inLanguage: 'hi-IN',
};
---
<BaseLayout title="AstroJyotish — राशिफल और ज्योतिष" description="दैनिक राशिफल, वार्षिक राशिफल और ज्योतिष से जुड़ी जानकारी।" schema={schema}>
<section class="hero"><div class="container hero-grid"><div><span class="eyebrow">✦ ज्योतिष • राशिफल • ज्ञान</span><h1>सितारों की भाषा को आसान तरीके से समझें।</h1><p>राशिफल, ग्रह-नक्षत्र और ज्योतिष से जुड़े उपयोगी लेख एक सरल और साफ अनुभव में पढ़ें।</p><a class="load-more" style="display:inline-block;text-decoration:none" href="#latest">नवीनतम लेख पढ़ें ↓</a></div><div class="hero-card"><div class="orb">☾</div><div><strong>आज का ज्योतिष</strong><br/>नए लेख और राशिफल नियमित रूप से पढ़ें।</div></div></div></section>
<AdSlot slot="homeTop" />
<section class="section"><div class="container"><div class="section-head"><div><h2>राशियों के अनुसार</h2><p>अपनी राशि से जुड़े लेख देखें।</p></div></div><div class="zodiac">{['मेष','वृषभ','मिथुन','कर्क','सिंह','कन्या','तुला','वृश्चिक','धनु','मकर','कुंभ','मीन'].map(z=><a href={`/tag/${slugify(z)}/`}>{z}</a>)}</div></div></section>
<section class="section" id="latest"><div class="container"><div class="section-head"><div><h2>नवीनतम लेख</h2><p>ज्योतिष और राशिफल की नई जानकारी।</p></div></div><div class="grid" id="post-grid">{posts.map((post,i)=><div class="post-item" data-index={i}><PostCard post={post}/></div>)}</div>{posts.length>6&&<button class="load-more" id="load-more">और लेख देखें</button>}<AdSlot slot="homeAfterPosts" /></div></section>
<section class="section"><div class="container"><div class="section-head"><div><h2>श्रेणियां</h2><p>विषय के अनुसार ब्राउज़ करें।</p></div></div><div class="zodiac">{categories.map(c=><a href={`/category/${slugify(c)}/`}>{c}</a>)}</div></div></section>
<script>
const items=[...document.querySelectorAll('.post-item')];const btn=document.querySelector('#load-more');let shown=6;if(btn){items.forEach((x,i)=>{if(i>=shown)x.style.display='none'});btn.addEventListener('click',()=>{shown+=6;items.forEach((x,i)=>{if(i<shown)x.style.display='block'});if(shown>=items.length)btn.remove()})}
</script>
</BaseLayout>
