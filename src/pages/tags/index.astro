---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugify } from '../../lib/slug';
const posts=await getCollection('posts');
const tags=[...new Set(posts.flatMap(p=>p.data.tags))].sort((a,b)=>a.localeCompare(b));
---
<BaseLayout title="Job Tags — Job Career Hub" description="Browse job and career articles by tag."><div class="container page-title"><span class="eyebrow">BROWSE</span><h1>Job Tags</h1><p>Explore articles by job title, skill, company, location and career topic.</p></div><section class="section"><div class="container tag-cloud">{tags.map(tag=><a class="tag" href={`/tag/${slugify(tag)}/`}>{tag}</a>)}</div></section></BaseLayout>
