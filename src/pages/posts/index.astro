---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('posts')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="सभी लेख — AstroJyotish"><div class="container page-title"><h1>सभी लेख</h1><p>हमारे सभी ज्योतिष और राशिफल लेख।</p></div><section class="section"><div class="container"><div class="grid">{posts.map(post=><PostCard post={post}/>)}</div></div></section></BaseLayout>
